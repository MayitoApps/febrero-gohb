# Cadena de conexión pooled de Neon Postgres (PgBouncer, recomendada para la app en Vercel)
# Ejemplo: postgres://neondb_owner:PASSWORD@ep-xxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Cadena de conexión directa sin pooler (usada por Drizzle Kit para migraciones DDL)
# Ejemplo: postgres://neondb_owner:PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=""

# PIN de acceso para /generador (opcional; si se omite usa el valor por defecto en src/data/hotels.ts)
CONCIERGE_PIN="ORGANICO2027"

# Llave secreta para firmar cookies de sesión de Concierge en producción (recomendado definir un texto largo aleatorio en Vercel)
AUTH_SECRET=""

